<?xml version="1.0"?>

<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <!-- Reasonable line length for course code. -->
    <module name="LineLength">
        <property name="max" value="100"/>
        <property name="ignorePattern" value="^package.*|^import.*"/>
    </module>

    <module name="TreeWalker">

        <!-- Import/style issues. google-java-format handles many of these. -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>

        <!-- Braces and whitespace. Mostly fixed by google-java-format. -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>
        <module name="OneStatementPerLine"/>
        <module name="EmptyLineSeparator"/>

        <!-- Naming conventions. google-java-format will NOT fix these. -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="LocalVariableName"/>

        <!-- Require parameter names to be at least two characters.
             This catches starter names like s and c. -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{1,}$"/>
        </module>

        <!-- Prevent hard-coded numeric rules like 18.
             Students should replace 18 with MAX_CREDIT_HOURS. -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1,0,1,2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
        </module>

        <!-- Encourages cleaner declarations. -->
        <module name="MultipleVariableDeclarations"/>

        <!-- Helps reinforce encapsulation.
             This will catch package-private or public fields. -->
        <module name="VisibilityModifier"/>

    </module>
</module>